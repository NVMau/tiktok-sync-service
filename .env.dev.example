# =============================================================================
# DEVELOPMENT ENVIRONMENT CONFIGURATION
# Copy this file to .env for local development
# =============================================================================

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
PORT=8000
ENVIRONMENT=development

# =============================================================================
# LOGGING
# =============================================================================
LOG_LEVEL=debug
LOG_OUTPUT=stdout

# =============================================================================
# DATABASE - PostgreSQL
# =============================================================================
# IMPORTANT: Change default password for security
POSTGRES_USER=tiktok_sync
POSTGRES_PASSWORD=changeme
POSTGRES_DB=tiktok_sync_db

DATABASE_URL=postgres://tiktok_sync:changeme@localhost:5432/tiktok_sync_db?sslmode=disable

# =============================================================================
# REDIS
# =============================================================================
REDIS_URL=localhost:6379

# =============================================================================
# TIKTOK SHOP API
# =============================================================================
TIKTOK_APP_KEY=your_app_key_here
TIKTOK_APP_SECRET=your_app_secret_here
TIKTOK_SERVICE_ID=your_service_id_here

# Optional: Webhook secret for signature verification
TIKTOK_WEBHOOK_SECRET=your_webhook_secret_here

# Optional: Override TikTok API URLs (usually not needed)
# TIKTOK_API_BASE_URL=https://open-api.tiktokglobalshop.com
# TIKTOK_AUTH_BASE_URL=https://auth.tiktok-shops.com

# =============================================================================
# CALLBACK CONFIGURATION
# =============================================================================
# URL to receive callbacks when order events occur (leave empty to disable)
CALLBACK_URL=https://your-service.com/api/tiktok/callback

# Secret key for HMAC-SHA256 signature verification (recommended for security)
CALLBACK_SECRET=your_callback_secret_here

# Callback request timeout in seconds (default: 10)
CALLBACK_TIMEOUT=10

# Number of retries for failed callbacks (default: 3)
CALLBACK_RETRIES=3

# =============================================================================
# NGROK (for local webhook testing)
# =============================================================================
# Get your auth token from https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=your_ngrok_token_here
